	column 'Data Vigente?' =
			IF(
			    dCalendario[Datas] <= MAX(fVendas[Data da Venda]),
			    "Sim",
			    "Não"
			)
		lineageTag: ff6cd98c-3296-4d1f-a9bc-0580f0ee2e54
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source =
				CALENDAR(
				    DATE(YEAR(MIN(fVendas[Data da Venda])), 1, 1),
				    DATE(YEAR(MAX(fVendas[Data da Venda])), 12, 31)
				)

	annotation PBI_Id = d96a3bf56939432ab6f9966d4ff6e251

