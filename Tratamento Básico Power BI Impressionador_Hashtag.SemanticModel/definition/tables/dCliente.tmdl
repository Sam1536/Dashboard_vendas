	column 'Faixa Etaria' =
			SWITCH(TRUE(),
			dCliente[Idade] <= 20, "Jovem",
			dCliente[Idade] <= 50, "Adulto",
			"Sênio")
		lineageTag: 9d1e5ff8-7b08-42c4-9064-5a5d2329037c
		summarizeBy: none
		sortByColumn: 'Numeração Faixa Etária'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Numeração Faixa Etária' =
			SWITCH(TRUE(),
			dCliente[Idade] <= 20, 1,
			dCliente[Idade] <= 50, 2,
			3)
		formatString: 0
		lineageTag: af980447-4258-4e4c-afac-0058d4319533
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Desconto = ```
			SWITCH(dCliente[Nivel Escolar],
			"Pós Graduação", 0.2,
			"Superior Completo", 0.1,
			"Superior Incompleto", 0.05,
			0)
			// Formula de cima e mais direta e simples e so usamos ela como for usa com (True E <= ou >=)
			
			// Antigo com (true e com <= ou >=)
			/* 
			Desconto = SWITCH(TRUE(),
			dCliente[Nivel Escolar] = "Pós Graduação", 0.2,
			dCliente[Nivel Escolar] = "Superior Completo", 0.1,
			dCliente[Nivel Escolar] = "Superior Incompleto", 0.05,
			0) 
			*/
			```
